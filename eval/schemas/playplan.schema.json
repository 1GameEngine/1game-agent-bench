{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.playplan/1",
  "title": "eval.playplan/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "steps"],
  "properties": {
    "schema": { "const": "eval.playplan/1" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    },
    "until": false,
    "uid": false,
    "locator": false,
    "wait_wall": false,
    "screenshot": false,
    "bash": false
  }
}
