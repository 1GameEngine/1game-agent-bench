{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.p1-task/1",
  "title": "P1 task.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tier",
    "scenarios",
    "scene",
    "rng",
    "physics",
    "judge",
    "traces",
    "replay_fps",
    "sample_fps",
    "max_demo_seconds",
    "input"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^p1-" },
    "tier": { "const": "P1" },
    "entry": { "const": "src/game.tsx" },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allow_empty"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "allow_empty": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "width", "height"],
      "properties": {
        "count": { "const": 1 },
        "width": { "const": 1280 },
        "height": { "const": 720 }
      }
    },
    "rng": { "const": "forbidden" },
    "physics": { "const": "forbidden" },
    "judge": { "const": "rubric_replay" },
    "traces": { "const": "submitted" },
    "replay_fps": { "const": 30 },
    "sample_fps": { "type": "integer", "minimum": 1, "maximum": 10 },
    "max_demo_seconds": { "type": "integer", "minimum": 1, "maximum": 20 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "keys"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["keydown", "keyup", "click"] }
        },
        "keys": {
          "type": "array",
          "items": {
            "enum": ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Space", "Enter", "KeyW", "KeyA", "KeyS", "KeyD"]
          }
        }
      }
    }
  }
}
