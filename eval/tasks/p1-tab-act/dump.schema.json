{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.p1-tab-act/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval.schema_id",
    "eval.schema_sha256",
    "tab",
    "count_red",
    "count_blue"
  ],
  "properties": {
    "eval.schema_id": {
      "const": "eval.p1-tab-act/1"
    },
    "eval.schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tab": {
      "enum": [
        "red",
        "blue"
      ]
    },
    "count_red": {
      "type": "integer",
      "minimum": 0
    },
    "count_blue": {
      "type": "integer",
      "minimum": 0
    }
  }
}
