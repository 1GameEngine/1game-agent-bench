{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.p1-grid-scout/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval.schema_id",
    "eval.schema_sha256",
    "x",
    "marked"
  ],
  "properties": {
    "eval.schema_id": {
      "const": "eval.p1-grid-scout/1"
    },
    "eval.schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "marked": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "boolean"
      }
    }
  }
}
