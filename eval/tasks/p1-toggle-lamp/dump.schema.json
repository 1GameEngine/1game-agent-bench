  "required": [
    "eval.schema_id",
    "eval.schema_sha256",
    "on"
  ],
  "properties": {
    "eval.schema_id": {
      "const": "eval.p1-toggle-lamp/1"
    },
    "eval.schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "on": {
      "type": "boolean"
    }
  }
}
